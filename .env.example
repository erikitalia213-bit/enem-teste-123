# =============================================================================
# Protocolo 42 Dias — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e cadastre as mesmas na Vercel.
# =============================================================================

# --- Supabase (Painel → Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NUNCA exponha no navegador. Usada só no servidor (webhooks, login, seed).
SUPABASE_SERVICE_ROLE_KEY=

# --- Webhooks de compra (gere tokens longos e aleatórios, ex.: openssl rand -hex 32) ---
WEBHOOK_SECRET_KIRVANO=
WEBHOOK_SECRET_WIAPY=
# Token da rota de captura /api/webhooks/debug (deixe vazio para desativar a rota)
WEBHOOK_SECRET_DEBUG=

# --- App ---
# URL pública, sem barra no final (ex.: https://app.protocolo42dias.com.br)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Suporte (aparece no login, no bloqueio de acesso e no perfil) ---
NEXT_PUBLIC_SUPORTE_EMAIL=suporte@seudominio.com.br
# Só números, com DDI e DDD (ex.: 5511999999999). Deixe vazio para esconder o WhatsApp.
NEXT_PUBLIC_SUPORTE_WHATSAPP=

# --- E-mail (SMTP próprio via Resend) ---
# O app NÃO envia e-mail diretamente: quem envia o convite e o link mágico é o
# Supabase Auth, usando o SMTP do Resend configurado no painel do Supabase
# (Authentication → Emails → SMTP Settings). Veja o passo a passo no README.
# Estas variáveis são lidas pelo supabase/config.toml quando você usa o Supabase CLI
# (supabase start / supabase config push) e servem de referência para o painel.
RESEND_API_KEY=
SMTP_REMETENTE_EMAIL=acesso@seudominio.com.br
SMTP_REMETENTE_NOME=Protocolo 42 Dias
