# ============================================================
# FLAGLAB 5x5 · Variables de entorno
# Copia este archivo como .env.local (desarrollo) o cárgalas en tu hosting (Vercel → Settings → Environment Variables).
#
# REGLA: lo que empieza con NEXT_PUBLIC_ es visible en el navegador (no pongas secretos ahí).
#        Lo que NO empieza con NEXT_PUBLIC_ solo existe en el servidor.
# ============================================================

# ---------- Sitio ----------
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com
NEXT_PUBLIC_SUPPORT_EMAIL=soporte@tu-dominio.com

# ---------- Datos legales (Aviso de privacidad / Términos) ----------
NEXT_PUBLIC_LEGAL_OWNER=Nombre o razón social del responsable
NEXT_PUBLIC_LEGAL_ADDRESS=Domicilio para oír y recibir notificaciones
NEXT_PUBLIC_PRIVACY_EMAIL=privacidad@tu-dominio.com

# ---------- Supabase (OBLIGATORIO en producción) ----------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Usa la "anon" key o la "publishable" key (una de las dos). Es pública por diseño; RLS protege los datos.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SECRETO. Solo servidor (webhooks). Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Checkout ----------
# hotmart | kiwify | generic
NEXT_PUBLIC_CHECKOUT_PROVIDER=hotmart
# Link de pago del producto principal (con order bumps configurados en la plataforma)
NEXT_PUBLIC_CHECKOUT_URL=
# Opcional: links para vender cada complemento por separado (a quien ya tiene FLAGLAB)
NEXT_PUBLIC_CHECKOUT_URL_DEFENSIVE=
NEXT_PUBLIC_CHECKOUT_URL_EXTRA_TRAININGS=
NEXT_PUBLIC_CHECKOUT_URL_SCHOOL_KIT=

# ---------- Webhook Hotmart (si usas Hotmart) ----------
# SECRETO: el "Hottok" de Hotmart (Herramientas → Webhook)
HOTMART_HOTTOK=
# idProductoHotmart:producto, separados por coma. Productos válidos:
# core_flaglab, defensive_playbook, extra_trainings, school_coach_kit
HOTMART_PRODUCT_MAP=1234567:core_flaglab,1234568:defensive_playbook,1234569:extra_trainings,1234570:school_coach_kit

# ---------- Webhook Kiwify (si usas Kiwify) ----------
# SECRETO: token del webhook en Kiwify (Apps → Webhooks)
KIWIFY_WEBHOOK_TOKEN=
KIWIFY_PRODUCT_MAP=uuid-producto-principal:core_flaglab,uuid-bump-1:defensive_playbook

# ---------- Analítica ----------
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_ID=
# SECRETO: token de la API de Conversiones de Meta (Purchase desde el servidor)
META_CAPI_ACCESS_TOKEN=
# Opcional, solo para probar en Administrador de eventos → Probar eventos. Bórralo al lanzar.
META_TEST_EVENT_CODE=
# SECRETO: GA4 → Administrar → Flujos de datos → Measurement Protocol API secrets
GA_API_SECRET=

# ---------- Solo desarrollo local ----------
# true = entra sin Supabase con todos los productos. Se IGNORA cuando NODE_ENV=production.
FLAGLAB_DEV_BYPASS_AUTH=
